# Never commit real values. Inject secrets via deployment secret manager.
ENVIRONMENT=production
AUTO_CREATE_SCHEMA=false
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/traceweave
JWT_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRE_MINUTES=60
ADMIN_USERNAME=replace-with-admin-name
ADMIN_PASSWORD=replace-with-unique-password-at-least-16-characters
DEMO_MODE=false
