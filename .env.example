# Copy this file to .env and set values before deployment.
# Local development defaults to SQLite if DATABASE_URL is not set.
DATABASE_URL=postgresql+psycopg://traceweave:change_me@localhost:5432/traceweave
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-strong-password
DEMO_MODE=true
